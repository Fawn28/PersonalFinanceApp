@page "/"
@page "/home"
@rendermode InteractiveServer
@using PersonalFinanceApp.Components.Entities
@using PersonalFinanceApp.Components.Models
@inject TransactionService TransactionService
@inject BudgetService BudgetService

<PageTitle>Home</PageTitle>


<div class="welcome-section">
    <h2>Welcome back! </h2>
    
</div>

<div class="summary-cards">
    <div class="card">
        <h3>Total Balance</h3>
        <p class="amount">$@totalBalance</p>
    </div>
    
    <div class="card">
        <h3>This Month's Spending</h3>
        <p class="amount spending">$@monthlySpending</p>
    </div>
    
    <div class="card">
        <h3>Budget Remaining</h3>
        <p class="amount">$@budgetRemaining</p>
    </div>
</div>

<div class="navigation-buttons">
    
    <a href="/transactions" class="btn">Transactions</a>
    <a href="/budgets" class="btn">Budgets</a>
    <a href="/analytics" class="btn">Analytics</a>
</div>


@code
{
    private decimal totalBalance = 0;
    private decimal monthlySpending = 0;
    private decimal budgetRemaining = 0;

    protected override void OnInitialized()
    {
        // Use service methods
        totalBalance = TransactionService.GetBalance();
        monthlySpending = CalculateMonthlySpending();
        
        var budgets = BudgetService.GetAll();
        var totalBudget = budgets.Sum(b => b.TargetAmount);
        budgetRemaining = totalBudget - monthlySpending;
    }
    
    private decimal CalculateMonthlySpending()
    {
        var thisMonth = DateTime.Now.Month;
        var thisYear = DateTime.Now.Year;
        
        return TransactionService.GetExpenses()
            .Where(e => e.Date.Month == thisMonth && e.Date.Year == thisYear)
            .Sum(e => e.Amount);
    }
}

<style>

    .welcome-section {
        margin-bottom: 60px;
    }

    .welcome-section h2 {
        font-size: 28px;
        color: #8E6F9D;
        
    }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        margin: 40px 0;
    }

    .card {
        background: linear-gradient(135deg, #A888B5 0%, #8E6F9D 100%);
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(168, 136, 181, 0.2);
        text-align: center;
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .card h3 {
        color: rgba(255, 255, 255, 0.9);
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 15px;
    }

    .amount {
        font-size: 36px;
        font-weight: bold;
        color: white;
        margin: 0;
    }
    
    .navigation-buttons {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 50px;
    }

    .navigation-buttons .btn {
        background: white;
        color: #A888B5;
        border: 2px solid #A888B5;
        padding: 15px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s;
    }

    .navigation-buttons .btn:hover {
        background-color: #A888B5;
        color: white;
    }
</style>
