@page "/transactions"
@rendermode InteractiveServer
@using PersonalFinanceApp.Components.Data
@using PersonalFinanceApp.Components.Entities
@using PersonalFinanceApp.Components.Models
@inject TransactionService TransactionService

<PageTitle>Transactions</PageTitle>

<div class="transaction-type-tabs">
    <button class="tab-button @(isExpense ? "active" : "")" @onclick="() => SetType(true)">
        Expenses
    </button>
    <button class="tab-button @(isExpense ? "" : "active")" @onclick="() => SetType(false)">
        Income
    </button>
</div>

<div class="transaction-container">
    <div class="transaction-form">
        <h3>Add @(isExpense ? "Expense" : "Income")</h3>
        
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="status-message @statusClass">
                @statusMessage
            </div>
        }
        
        <label>Date:</label>
        <input type="date" @bind="selectedDate" />
        
        <label>Category:</label>
        <select @bind="category" class="form-select">
            <option value="">-- Select Category --</option>
            
            @if (isExpense)
            {
                <option value="Food">🍔 Food & Dining</option>
                <option value="Transport">🚗 Transportation</option>
                <option value="Shopping">👕 Shopping</option>
                <option value="Entertainment">🎬 Entertainment</option>
                <option value="Bills">💡 Bills & Utilities</option>
                <option value="Grocery">🥦 Grocery</option>
                <option value="Other">💰 Other</option>
            }
            else
            {
                <option value="Salary">💼 Salary</option>
                <option value="Freelance">💸 Freelance</option>
                <option value="Investment">📈 Investment</option>
                <option value="Gift">🎁 Gift</option>
                <option value="Other">💰 Other</option>
            }
        </select>
        
        <label>Amount:</label>
        <input type="number" @bind="amount" placeholder="0.00" step="0.01" />
        
        <button class="btn-add" @onclick="AddTransaction">Add Transaction</button>
        
        <!-- Summary Section -->
        <div class="summary-box">
            <div class="summary-item">
                <span class="summary-label">Total Income:</span>
                <span class="summary-value income">+$@TransactionService.GetTotalIncome().ToString("N2")</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Total Expenses:</span>
                <span class="summary-value expense">-$@TransactionService.GetTotalExpenses().ToString("N2")</span>
            </div>
            <div class="summary-item balance">
                <span class="summary-label">Balance:</span>
                <span class="summary-value @(TransactionService.GetBalance() >= 0 ? "positive" : "negative")">
                    $@TransactionService.GetBalance().ToString("N2")
                </span>
            </div>
        </div>
    </div>

    <div class="transaction-list">
        <div class="list-header">
            <h3>Recent Transactions</h3>
            <span class="transaction-count">(@displayedTransactions.Count)</span>
        </div>
        
        @if (displayedTransactions.Count == 0)
        {
            <p class="empty-message">No transactions yet. Add your first one!</p>
        }
        else
        {
            <div class="transactions-wrapper">
                @foreach (var trans in displayedTransactions.OrderByDescending(t => t.Date).Take(20))
                {
                    <div class="transaction-item @(trans.Type.ToLower())">
                        <div class="trans-info">
                            <strong>@GetCategoryIcon(trans.Category) @trans.Category</strong>
                            <small>@trans.Date.ToString("MMM d, yyyy")</small>
                        </div>
                        
                        <div class="trans-actions">
                            <div class="trans-amount">@(trans.Type == "Expense" ? "-" : "+")$@trans.Amount.ToString("N2")</div>
                            <button class="btn-delete" @onclick="() => DeleteTransaction(trans.Id)">🗑️</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private DateTime selectedDate = DateTime.Today;
    private string category = "";
    private decimal amount = 0;
    private bool isExpense = true;
    
    private List<ITransaction> allTransactions = new();
    private List<ITransaction> displayedTransactions = new();
    
    private string statusMessage = "";
    private string statusClass = "";
    
    protected override void OnInitialized()
    {
        // Initializes the component by loading all transactions
        LoadTransactions();
    }
    
    private void LoadTransactions()
    {
        // Retrieves all transactions and filters them based on current view type
        allTransactions = TransactionService.GetAll().ToList();
        FilterTransactions();
    }
    
    private void SetType(bool expense)
    {
        // Toggles between expense and income views and resets the category selection
        isExpense = expense;
        category = "";
        FilterTransactions();
    }
    
    private void FilterTransactions()
    {
        // Filters the transaction list to show only expenses or income based on current view
        if (isExpense)
        {
            displayedTransactions = allTransactions.Where(t => t.Type == "Expense").ToList();
        }
        else
        {
            displayedTransactions = allTransactions.Where(t => t.Type == "Income").ToList();
        }
        
        StateHasChanged();
    }
    
    private void AddTransaction()
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            ShowStatus("Please select a category", "error");
            return;
        }
        
        if (amount <= 0)
        {
            ShowStatus("Please enter a valid amount", "error");
            return;
        }
        
        try
        {
            // Creates and saves a new transaction based on form inputs and current transaction type
            ITransaction transaction = isExpense
                ? new Expense
                {
                    Date = selectedDate,
                    Category = category,
                    Amount = amount
                }
                : new Income
                {
                    Date = selectedDate,
                    Category = category,
                    Amount = amount
                };
            
            TransactionService.AddTransaction(transaction);
            ShowStatus($"{(isExpense ? "Expense" : "Income")} added successfully!", "success");
            
            category = "";
            amount = 0;
            selectedDate = DateTime.Today;
            
            LoadTransactions();
        }
        catch (Exception ex)
        {
            ShowStatus($"Error: {ex.Message}", "error");
        }
    }
    
    private void DeleteTransaction(int transactionId)
    {
        // Removes a transaction by its ID and refreshes the transaction list
        try
        {
            TransactionService.DeleteTransaction(transactionId);
            ShowStatus("Transaction deleted", "success");
            LoadTransactions();
        }
        catch (Exception ex)
        {
            ShowStatus($"Error: {ex.Message}", "error");
        }
    }
    
    private void ShowStatus(string message, string type)
    {
        // Displays a temporary status message that automatically disappears after 3 seconds
        statusMessage = message;
        statusClass = type;
        StateHasChanged();
        
        Task.Delay(3000).ContinueWith(_ => {
            statusMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }
    
    private string GetCategoryIcon(string category)
    {
        // Returns an appropriate emoji icon for each transaction category
        return category switch
        {
            "Salary" => "💼",
            "Freelance" => "💸",
            "Investment" => "📈",
            "Gift" => "🎁",
            
            "Food" => "🍔",
            "Transport" => "🚗",
            "Shopping" => "👕",
            "Entertainment" => "🎬",
            "Bills" => "💡",
            "Grocery" => "🥦",
            
            _ => "💰"
        };
    }
}

