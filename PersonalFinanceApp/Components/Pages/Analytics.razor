@page "/analytics"
@rendermode InteractiveServer
@using PersonalFinanceApp.Components.Entities
@using PersonalFinanceApp.Components.Models
@inject TransactionService TransactionService
@inject BudgetService BudgetService

<PageTitle>Analytics</PageTitle>

<h2>@timePeriod Overview</h2>

<div class="time-period-tabs">
    <button class="tab-button @(timePeriod == "Monthly" ? "active" : "")" 
            @onclick='() => SetTimePeriod("Monthly")'>
        Monthly
    </button>
    <button class="tab-button @(timePeriod == "Yearly" ? "active" : "")" 
            @onclick='() => SetTimePeriod("Yearly")'>
        Yearly
    </button>
</div>

<div class="analytics-container">
    <!-- Pie Chart Card -->
    <div class="chart-card">
        <h3>Spending by Category</h3>
        
        @if (totalSpending > 0)
        {
            <div class="pie-chart-container">
                <div class="css-pie-chart" style="@GetPieChartStyle()"></div>
                <div class="pie-center">
                    <div class="pie-total">$@totalSpending.ToString("F0")</div>
                    <div class="pie-label">Total</div>
                </div>
            </div>
            
            <div class="pie-legend">
                @foreach (var category in GetSortedCategories())
                {
                    decimal percentage = (category.Value / totalSpending) * 100;
                    <div class="legend-item">
                        <span class="legend-color" style="background: @GetCategoryColor(category.Key)"></span>
                        <span class="legend-text">@GetCategoryIcon(category.Key) @category.Key</span>
                        <span class="legend-value">$@category.Value.ToString("N0") (@percentage.ToString("F1")%)</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-chart">
                <p>No expense data available for this period</p>
            </div>
        }
    </div>
    
    <!-- Top Categories Card -->
    <div class="chart-card">
        <h3>Top Spending Categories</h3>
        
        @if (categorySpending.Any())
        {
            <div class="category-bars">
                @foreach (var category in GetSortedCategories().Take(5))
                {
                    decimal percentage = totalSpending > 0 ? (category.Value / totalSpending) * 100 : 0;
                    <div class="category-bar-item">
                        <div class="category-bar-header">
                            <span class="category-name">@GetCategoryIcon(category.Key) @category.Key</span>
                            <span class="category-amount">$@category.Value.ToString("N2")</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" 
                                 style="width: @percentage%; background: @GetCategoryColor(category.Key)">
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-chart">
                <p>No categories to display</p>
            </div>
        }
    </div>
</div>

@code {
    // Stores the current view mode (Monthly/Yearly) and controls the time range for analytics
    private string timePeriod = "Monthly";
    
    private decimal totalSpending = 0;
    
    private Dictionary<string, decimal> categorySpending = new();
    
    protected override void OnInitialized()
    {
        LoadData();
    }
    
    // Core data loading method that fetches expenses for the selected period and calculates spending by category
    private void LoadData()
    {
        var startDate = GetStartDate(timePeriod);
        var endDate = GetEndDate(timePeriod);
        
        var expenses = TransactionService.GetExpenses()
            .Where(e => e.Date >= startDate && e.Date <= endDate)
            .ToList();
        
        totalSpending = expenses.Sum(e => e.Amount);
        
        categorySpending = expenses
            .GroupBy(e => e.Category)
            .ToDictionary(g => g.Key ?? "Other", g => g.Sum(e => e.Amount));
    }
    
    private void SetTimePeriod(string period)
    {
        timePeriod = period;
        LoadData();
    }
    
    // Helper method that determines the start date based on selected time period
    private DateTime GetStartDate(string period)
    {
        return period switch
        {
            "Monthly" => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
            "Yearly" => new DateTime(DateTime.Today.Year, 1, 1),
            _ => DateTime.Today
        };
    }
    
    private DateTime GetEndDate(string period)
    {
        return period switch
        {
            "Monthly" => GetStartDate(period).AddMonths(1).AddSeconds(-1),
            "Yearly" => GetStartDate(period).AddYears(1).AddSeconds(-1),
            _ => DateTime.Today
        };
    }
    
    private List<KeyValuePair<string, decimal>> GetSortedCategories()
    {
        return categorySpending
            .OrderByDescending(x => x.Value)
            .ToList();
    }
    
    // Generates the CSS for the pie chart visualization using conic-gradient based on spending percentages
    private string GetPieChartStyle()
    {
        if (totalSpending == 0) return "background: #f0f0f0;";
        
        var colors = new List<string>();
        decimal cumulative = 0;
        
        foreach (var category in categorySpending.OrderByDescending(x => x.Value))
        {
            decimal percentage = (category.Value / totalSpending) * 100;
            string color = GetCategoryColor(category.Key);
            
            colors.Add($"{color} {cumulative}% {cumulative + percentage}%");
            cumulative += percentage;
        }
        
        return $"background: conic-gradient({string.Join(", ", colors)});";
    }
    
    // Maps category names to emoji icons for improved visual recognition in the UI
    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Food" => "🍔",
            "Transport" => "🚗",
            "Shopping" => "👕",
            "Entertainment" => "🎬",
            "Bills" => "💡",
            "Grocery" => "🥦",
            "Other" => "💰",
            _ => "📁"  // Default icon for unknown categories
        };
    }
    
    // Provides consistent color mapping for categories across all visualizations
    private string GetCategoryColor(string category)
    {
        return category switch
        {
            "Food" => "#f59b42",        
            "Transport" => "#4ECDC4",   
            "Shopping" => "#FFE66D",    
            "Entertainment" => "#A888B5", 
            "Bills" => "#f5425d",       
            "Grocery" => "#5c8257",     
            "Other" => "#CCCCCC",       
            _ => "#999999"              // Gray (default for unknown categories)
        };
    }
}

<style>
    h2 {
        font-size: 28px;
        color: #8E6F9D;
        margin-bottom: 30px;
    }
    
    h3 {
        color: #333;
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 20px;
    }
    
    .time-period-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
    }
    
    .tab-button {
        padding: 12px 30px;
        border: 2px solid #A888B5;
        background: white;
        color: #A888B5;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }
    
    .tab-button:hover {
        background: #f0e6f5;
    }
    
    .tab-button.active {
        background: #A888B5;
        color: white;
    }
    
    .analytics-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 30px;
        margin-bottom: 30px;
    }
    
    .chart-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .empty-chart {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }
    
    .pie-chart-container {
        position: relative;
        width: 280px;
        height: 280px;
        margin: 0 auto 30px;
    }
    
    .css-pie-chart {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        position: relative;
    }
    
    .pie-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }
    
    .pie-total {
        font-size: 28px;
        font-weight: bold;
        color: #A888B5;
    }
    
    .pie-label {
        font-size: 13px;
        color: #666;
    }
    
    .pie-legend {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
    }
    
    .legend-color {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        flex-shrink: 0;
    }
    
    .legend-text {
        flex: 1;
    }
    
    .legend-value {
        font-weight: 600;
        color: #666;
    }
    
    .category-bars {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .category-bar-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .category-bar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .category-name {
        font-weight: 600;
        color: #333;
    }
    
    .category-amount {
        font-weight: 700;
        color: #666;
    }
    
    .progress-bar {
        width: 100%;
        height: 20px;
        background: #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
    }
    
    .progress-fill {
        height: 100%;
        transition: width 0.3s;
    }
</style>