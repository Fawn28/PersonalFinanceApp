@page "/analytics"

<PageTitle>Analytics</PageTitle>

<h2>@timePeriod Overview</h2>

<div class="time-period-tabs">
    <button class="tab-button @(timePeriod == "Monthly" ? "active" : "")" 
            @onclick='() => SetTimePeriod("Monthly")'>
        Monthly
    </button>
    <button class="tab-button @(timePeriod == "Yearly" ? "active" : "")" 
            @onclick='() => SetTimePeriod("Yearly")'>
        Yearly
    </button>
</div>



<div class="analytics-container">
    <!-- CSS Pie Chart -->
    <div class="chart-card">
        
        <div class="pie-chart-container">
            <div class="css-pie-chart" style="@GetPieChartStyle()"></div>
            <div class="pie-center">
                <div class="pie-total">${totalSpending:F0}</div>
                <div class="pie-label">Total</div>
            </div>
        </div>
        <div class="pie-legend">
            @foreach (var category in GetSortedCategories())
            {
                decimal percentage = (category.Value / totalSpending) * 100;
                <div class="legend-item">
                    <span class="legend-color" style="background: @GetCategoryColor(category.Key)"></span>
                    <span class="legend-text">@GetCategoryIcon(category.Key) @category.Key</span>
                    <span class="legend-value">@percentage.ToString("F1")%</span>
                </div>
            }
        </div>
    </div>
</div>


@code {
    private string timePeriod = "Monthly";
    private decimal totalSpending = 0;
    
    private Dictionary<string, decimal> categorySpending = new()
    {
        { "Food", 450 },
        { "Transport", 180 },
        { "Shopping", 250 },
        { "Entertainment", 120 },
        { "Bills", 400 },
        { "Healthcare", 80 },
        { "Other", 50 }
    };
    
    protected override void OnInitialized()
    {
        totalSpending = categorySpending.Values.Sum();
    }
    
    private void SetTimePeriod(string period)
    {
        timePeriod = period;
    }
    
    private List<KeyValuePair<string, decimal>> GetSortedCategories()
    {
        return categorySpending
            .OrderByDescending(x => x.Value)
            .ToList();
    }
    
    private string GetPieChartStyle()
    {
        // Create conic gradient for pie chart
        var colors = new List<string>();
        decimal cumulative = 0;
        
        foreach (var category in categorySpending.OrderByDescending(x => x.Value))
        {
            decimal percentage = (category.Value / totalSpending) * 100;
            string color = GetCategoryColor(category.Key);
            
            colors.Add($"{color} {cumulative}% {cumulative + percentage}%");
            cumulative += percentage;
        }
        
        return $"background: conic-gradient({string.Join(", ", colors)});";
    }
    
    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Food" => "🍔",
            "Transport" => "🚗",
            "Shopping" => "👕",
            "Entertainment" => "🎬",
            "Bills" => "💡",
            "Healthcare" => "💊",
            "Other" => "💰",
            _ => "📁"
        };
    }
    
    private string GetCategoryColor(string category)
    {
        return category switch
        {
            "Food" => "#FF6B6B",
            "Transport" => "#4ECDC4",
            "Shopping" => "#FFE66D",
            "Entertainment" => "#A888B5",
            "Bills" => "#95E1D3",
            "Healthcare" => "#F38181",
            "Other" => "#CCCCCC",
            _ => "#999999"
        };
    }
}

<style>
    h2 {
        font-size: 28px;
        color: #8E6F9D;
         margin-bottom: 30px;
    }
    .time-period-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
    }
    
    .tab-button {
        padding: 12px 30px;
        border: 2px solid #A888B5;
        background: white;
        color: #A888B5;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }
    
    .tab-button.active {
        background: #A888B5;
        color: white;
    }
    
    .analytics-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px;
        margin-bottom: 30px;
        max-width: 600px;  /* Center the pie chart */
        margin-left: auto;
        margin-right: auto;
    }
    
    .chart-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .chart-card.full-width {
        grid-column: 1 / -1;
    }
    

    
    /* CSS Pie Chart */
    .pie-chart-container {
        position: relative;
        width: 300px;
        height: 300px;
        margin: 0 auto 30px;
    }
    
    .css-pie-chart {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        position: relative;
    }
    
    .pie-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }
    
    .pie-total {
        font-size: 32px;
        font-weight: bold;
        color: #A888B5;
    }
    
    .pie-label {
        font-size: 14px;
        color: #666;
    }
    
    .pie-legend {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    
    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
    }
    
    .legend-color {
        width: 16px;
        height: 16px;
        border-radius: 3px;
    }
    
    .legend-text {
        flex: 1;
    }
    
    .legend-value {
        font-weight: 600;
        color: #666;
    }
</style>